# Turso Database Configuration
# Get your database URL and token from https://turso.tech or via `turso db create`
#
# If left empty, the server automatically uses local SQLite (data/chaduvuko.db)
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here
